# Copia este archivo como .env y ajusta los valores. .env no se versiona.

# Servidor LLM local (Ollama, API compatible con OpenAI). D0-2.
# 127.0.0.1 y no localhost: en Windows, httpx tarda ~2 s por conexión nueva a
# localhost (prueba IPv6 primero). El modelo es el derivado con 8k de contexto
# (ollama/ebica-llama3.1.Modelfile, D1-2).
EBICA_LLM_BASE_URL=http://127.0.0.1:11434/v1
EBICA_LLM_MODEL=ebica-llama3.1

# Embeddings en CPU (Fase 1, CP2, D1-3). Elegido en docs/fase-1/comparacion_embeddings.md.
# Cambiarlo cambia la dimensión de los índices vectoriales: hay que recalcular la memoria.
EBICA_EMBEDDING_MODEL=BAAI/bge-m3

# Neo4j (Docker, CP4). D0-4.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia-esta-clave

# Carpeta de datos de las entidades.
EBICA_ENTITIES_DIR=entities

# Puerto del servidor de la API (CP5); la consola de Vite le reenvía /api y /ws.
EBICA_API_PORT=8000
