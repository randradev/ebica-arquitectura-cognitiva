# Copia este archivo como .env y ajusta los valores. .env no se versiona.

# Servidor LLM local (Ollama, API compatible con OpenAI). D0-2.
EBICA_LLM_BASE_URL=http://localhost:11434/v1
EBICA_LLM_MODEL=llama3.1

# Neo4j (Docker, CP4). D0-4.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia-esta-clave

# Carpeta de datos de las entidades.
EBICA_ENTITIES_DIR=entities
